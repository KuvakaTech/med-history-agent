# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it contains secrets.
# ──────────────────────────────────────────────────────────────

PROJECT_NAME="Clinical AI"
API_V1_STR="/api/v1"
DEBUG=false

# CORS — comma-separated allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
BACKEND_CORS_ALLOW_ALL=true

# ── MongoDB ─────────────────────────────────────────────────
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=clinical_ai

# ── Cloudflare R2 (optional — for audio storage) ────────────
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=clinical-audio

# ── LLM — at least one provider required ────────────────────
# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# Groq — used for streaming when key is set (fastest inference, free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google (Gemini) — used first if GOOGLE_API_KEY is set
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FAST_MODEL=gemini-2.0-flash

# ── Deepgram (STT + TTS fallback) ────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-luna-en

# ── ElevenLabs (cloned voice — TTS primary when set, English + Hindi) ──
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Auth ──────────────────────────────────────────────────────
# Secret used to sign JWTs — keep this private and rotate periodically.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15            # Short-lived access token (OAuth2 standard)
REFRESH_TOKEN_EXPIRE_DAYS=7      # Long-lived refresh token stored in httpOnly cookie

# ── Rate limiting (requests per minute, per IP, per worker) ───
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_VOICE=20/minute

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001

# ── Cabin consultation (live multi-speaker STT + analysis) ───
# Reuses ELEVENLABS_API_KEY above.
# Data-residency hosts (api.<region>.residency.elevenlabs.io) need a key issued in
# that region; a global key gets auth_error there.
ELEVENLABS_STT_WS_URL=wss://api.elevenlabs.io/v1/speech-to-text/realtime
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_STT_BATCH_MODEL=scribe_v2
# ISO 639-3 codes, not 639-1
CABIN_STT_SECONDARY_LANGUAGES=hin,eng,mar,guj
CABIN_STT_VAD_SILENCE_SECS=0.7
# Must stay false while include_timestamps is on — ElevenLabs rejects the combination.
CABIN_STT_FILTER_BACKGROUND_AUDIO=false
CABIN_STT_NO_VERBATIM=false
CABIN_PANEL_MIN_INTERVAL_SECS=8.0
CABIN_ROLE_DEBOUNCE_SECS=1.2
CABIN_MIN_NEW_WORDS_FOR_ANALYSIS=12
CABIN_SUGGEST_MAX_TOKENS=800
CABIN_PANEL_MAX_TOKENS=700
CABIN_PANEL_RECONCILE_MAX_TOKENS=2000
CABIN_PANEL_RECONCILE_EVERY_N_PASSES=12
CABIN_SUGGEST_CONTEXT_UTTERANCES=150
CABIN_PERSIST_INTERVAL_SECS=15.0
CABIN_AUDIO_QUEUE_MAX=100
CABIN_MAX_SESSION_MINUTES=90
CABIN_ARCHIVE_AUDIO=true
CABIN_REDIARIZE_ON_END=true
CABIN_TEST_HARNESS=false
# Concurrent live consultations one doctor account may hold. WebSocket routes are not
# covered by the HTTP rate limiter, so this is what bounds ElevenLabs socket usage.
CABIN_MAX_CONCURRENT_SESSIONS_PER_DOCTOR=3
# Cross-worker duplicate-connection lease. After a hard worker crash a session is
# reconnectable once the lease expires; a normal disconnect releases it immediately.
CABIN_LEASE_TTL_SECS=120
CABIN_LEASE_RENEW_SECS=20.0

# Used only for the per-session cost log line.
LLM_USD_TO_INR=88.0
